{
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@util/*": ["src/util/*"] // Ensure alias consistency
    },
    "strict": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "target": "ES2020",
    "moduleResolution": "node",
    "jsx": "react-jsx",
    "noImplicitAny": true,
    "types": ["vite/client"]
  },
  "include": ["src", "vite.config.ts"],
  "exclude": ["node_modules", "dist"]
}
