{
  "compilerOptions": {
    "baseUrl": ".",
    "strict": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": false,
    "jsx": "react-jsx",
    "noImplicitAny": true,
    "types": ["vite/client"],
    "noEmit": true,
    "skipLibCheck": true,
    "lib": ["DOM", "ESNext"]
  },
  "include": ["src", "vite.config.ts"],
  "exclude": ["node_modules", "dist", "vite.config.ts"]
}
